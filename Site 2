<!doctype html>

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>La Maison de la Nature</title>
  <meta name="description" content="Produits naturels — La Maison de la Nature" />
  <style>
    :root{
      --green:#1b5b2a; /* texte principal */
      --accent:#d9b33a; /* accent fleur doré */
      --bg:#ffffff;
      --muted:#6b6b6b;
      --maxw:1100px;
      --radius:12px;
      font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
    }
    html,body{height:100%;margin:0;background:var(--bg);color:var(--green)}
    a{color:var(--green);text-decoration:none}
    .container{max-width:var(--maxw);margin:0 auto;padding:28px}/* header */
header{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
.brand{display:flex;align-items:center;gap:14px}
.brand img{height:78px;width:auto;display:block}
.brand h1{font-size:20px;margin:0;letter-spacing:0.6px}
nav{display:flex;gap:14px;align-items:center}
nav a{padding:8px 12px;border-radius:8px}
nav a.btn{background:var(--accent);color:#081214;font-weight:600}

/* hero */
.hero{display:flex;gap:28px;align-items:center;padding:28px 0;border-bottom:1px solid #eee}
.hero-left{flex:1}
.hero-left h2{font-size:36px;margin:0 0 10px}
.hero-left p{color:var(--muted);font-size:16px;line-height:1.6}
.cta{display:flex;gap:12px;margin-top:16px}
.btn-primary{background:var(--green);color:#fff;padding:12px 18px;border-radius:10px;border:none}
.btn-outline{background:transparent;border:2px solid var(--green);padding:10px 16px;border-radius:10px}

.hero-right{width:340px;flex-shrink:0}
.hero-right .card{background:#fff;border-radius:16px;padding:18px;box-shadow:0 6px 20px rgba(20,20,20,0.06);text-align:center}
.product-image{width:100%;height:240px;background:#f5f5f5;border-radius:10px;display:flex;align-items:center;justify-content:center}
.product-image img{max-width:100%;max-height:100%;object-fit:contain}

/* products section */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin-top:18px}
.card-product{background:#fff;padding:12px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,0.04);display:flex;flex-direction:column}
.card-product img{width:100%;height:160px;object-fit:cover;border-radius:8px}
.card-product h3{margin:10px 0 6px;font-size:18px}
.price{font-weight:700;color:var(--accent)}

footer{padding:28px 0;color:var(--muted);font-size:14px;border-top:1px solid #eee;margin-top:36px}

/* responsive */
@media(max-width:800px){
  .hero{flex-direction:column}
  .hero-right{width:100%}
  .brand img{height:60px}
  .hero-left h2{font-size:24px}
}

  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand">
        <!-- place your PNG logo file at assets/logo.png in the repo -->
        <img src="assets/logo.png" alt="La Maison de la Nature" id="site-logo" />
        <div>
          <h1>La Maison de la Nature</h1>
          <div style="color:var(--muted);font-size:13px">Produits naturels • Shilajit, miel et plus</div>
        </div>
      </div>
      <nav>
        <a href="index.html">Accueil</a>
        <a href="produits.html">Produits</a>
        <a href="contact.html">Contact</a>
        <a class="btn" href="#">Acheter</a>
      </nav>
    </header><main>
  <section class="hero">
    <div class="hero-left">
      <h2>Shilajit d'Altaï — Naturel &amp; Pur</h2>
      <p>Shilajit 100% naturel, testé en laboratoire. Renforce l'énergie, la concentration et la vitalité. Pot 50g — présentation premium.</p>
      <div class="cta">
        <button class="btn-primary">Acheter maintenant</button>
        <button class="btn-outline">En savoir plus</button>
      </div>
    </div>
    <div class="hero-right">
      <div class="card">
        <div class="product-image">
          <!-- Replace with product image -->
          <img src="assets/shilajit-50g.jpg" alt="Shilajit 50g" />
        </div>
        <h3>Shilajit d'Altaï — 50g</h3>
        <div class="price">11,00 €</div>
      </div>
    </div>
  </section>

  <section style="margin-top:26px">
    <h3>Nos produits</h3>
    <div class="grid">
      <article class="card-product">
        <img src="assets/shilajit-50g.jpg" alt="Shilajit 50g" />
        <h3>Shilajit d'Altaï — 50g</h3>
        <div class="price">11,00 €</div>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">Pur, sans additif — pot compris.</p>
        <div style="margin-top:auto;display:flex;gap:8px;margin-top:10px">
          <a class="btn-primary" href="#">Ajouter au panier</a>
          <a class="btn-outline" href="#">Détails</a>
        </div>
      </article>

      <article class="card-product">
        <img src="assets/miel.jpg" alt="Miel" />
        <h3>Miel de jujubier — 250g</h3>
        <div class="price">19,90 €</div>
        <p style="color:var(--muted);font-size:14px;margin-top:8px">Pur et de qualité premium.</p>
        <div style="margin-top:auto;display:flex;gap:8px;margin-top:10px">
          <a class="btn-primary" href="#">Ajouter au panier</a>
          <a class="btn-outline" href="#">Détails</a>
        </div>
      </article>

      <!-- add more product cards here -->
    </div>
  </section>

</main>

<footer>
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <div>© La Maison de la Nature — Toutes droits réservés</div>
    <div style="color:var(--muted)">Contact : contact@lamaisondelanature.fr</div>
  </div>
</footer>

  </div>  <!-- Simple script to handle missing images & quick instructions -->  <script>
    // if logo or product images missing, show simple placeholder
    document.querySelectorAll('img').forEach(img=>{
      img.onerror = function(){
        this.style.display='none';
      }
    });
  </script></body>
</html> 
